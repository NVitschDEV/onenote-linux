{
  "name": "onenote-linux-browser-app",
  "productName": "OneNote",
  "desktopName": "onenote-linux",
  "version": "1.3.0",
  "description": "OneNote Linux app-window launcher with native browser passkey and notebook routing support",
  "author": "OpenAI",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "publish": null,
    "appId": "com.onenote.linux.authenticator",
    "productName": "OneNote",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "assets/onenote-navigation-extension",
        "to": "onenote-navigation-extension"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableName": "onenote-linux",
      "syncDesktopName": true,
      "artifactName": "OneNote-${version}-${arch}.AppImage"
    },
    "appImage": {
      "artifactName": "OneNote-${version}-${arch}.AppImage"
    }
  }
}
